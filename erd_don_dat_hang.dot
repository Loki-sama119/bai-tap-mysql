digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.5", nodesep="0.55", ranksep="1.05", splines=polyline, fontname="DejaVu Sans", label="ERD – QUẢN LÝ ĐƠN ĐẶT HÀNG\nMô hình sau khi gộp Đơn vị đặt hàng và Đơn vị khách hàng", labelloc=t, fontsize=23, fontcolor="#233954"];
